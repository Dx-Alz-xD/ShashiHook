# ─────────────────────────────────────────────────────────────────────────────
# Sentinel — mailbox access
#
# IMPORTANT: Gmail does NOT support plain API keys for reading a mailbox.
# An API key only reaches public data. Reading your own mail requires either
# OAuth 2.0 (option A) or an app password over IMAP (option B).
# Pick ONE. Copy this file to `.env` and fill it in. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Option A: Gmail API over OAuth 2.0  (recommended) ────────────────────────
# Read-only scope, revocable from your Google account at any time, and no
# password ever lands in this file.
#
#  1. https://console.cloud.google.com/  →  create or pick a project
#  2. APIs & Services → Library → enable "Gmail API"
#  3. APIs & Services → OAuth consent screen → External → add your own
#     address under "Test users"
#  4. Credentials → Create credentials → OAuth client ID → Desktop app
#  5. Paste the client ID and secret below, then run:  sentinel auth
#
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Or, instead of the two values above, point at the downloaded JSON:
# GMAIL_CREDENTIALS_FILE=/absolute/path/to/client_secret.json

# Where the refresh token is cached after `sentinel auth`. Gitignored.
# GMAIL_TOKEN_PATH=.gmail_token.json


# ── Option B: IMAP with an app password  (simpler, blunter) ──────────────────
# Needs 2-Step Verification enabled, then generate a 16-character app password
# at https://myaccount.google.com/apppasswords
#
# Trade-off worth knowing: an app password grants FULL mailbox access —
# read, send and delete — and cannot be scoped down. OAuth above is read-only.
#
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=


# ── Scan behaviour ───────────────────────────────────────────────────────────
SENTINEL_MAILBOX=INBOX
# Gmail search syntax for the API path; translated to IMAP where possible.
SENTINEL_QUERY=newer_than:7d
SENTINEL_LIMIT=50

# Write a full incident report for anything at or above this band.
# CRITICAL | HIGH | MEDIUM | LOW | INFORMATIONAL
SENTINEL_MIN_BAND=MEDIUM
SENTINEL_REPORT_DIR=reports

# Off by default: reports quote only the short evidence spans that drove the
# score, never whole message bodies. Turn on only if you need full context and
# understand the reports will then contain your mail on disk.
SENTINEL_SAVE_BODIES=false

# Realistic fraction of scanned mail that is actually hostile.
# The model was trained on a corpus that is 49% malicious; a normal inbox is
# 1-5%. Without this correction the model flagged 46% of a real mailbox and
# produced 18 MEDIUM alerts that were all false positives. Set to 0 to disable.
# Higher = more sensitive (more alerts, more noise). Deterministic floors --
# executable attachments, BEC triad, failed auth -- ignore this entirely.
SENTINEL_INBOX_BASE_RATE=0.02

# Look up sender-domain registration age via RDAP (public registry data).
# A domain registered days ago that asks you to sign in is among the strongest
# phishing signals there is. Off by default because enabling it tells the RDAP
# operator which domains you are analysing — no message content is ever sent.
# Results are cached locally, so repeat scans cost no network.
SENTINEL_ENABLE_RDAP=false


# ── Narrative threat profiling (ArnosAI tactic write-ups) ────────────────────
# Explains, in plain language, which manipulation tactics a scam is using and
# how to recognise them next time.
#
# ADVISORY ONLY. These keys change no score. The verdict, the severity and the
# attack vector come from the local models and rules and keep working with no
# key set — profiling simply does not appear.
#
# Gemini is tried first, Groq second. Configure either or both.
#   Gemini key:  https://aistudio.google.com/apikey
#   Groq key:    https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_PRIMARY=gemini
# LLM_TIMEOUT=30
# Profile automatically when a message is opened in the dashboard.
# LLM_AUTO_PROFILE=true


# ── Optional enrichment ──────────────────────────────────────────────────────
# Newline-separated domains. Known-bad adds +25 severity on a match.
# SENTINEL_IOC_FILE=intel/known_bad_domains.txt
# Domains that may legitimately link to executables (your release host etc).
# SENTINEL_SOFTWARE_ALLOWLIST_FILE=intel/software_allowlist.txt
